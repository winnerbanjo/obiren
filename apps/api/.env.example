# =============================================================================
# Obiren API Environment Configuration
# =============================================================================
# Copy to .env and fill in real values. NEVER commit real secrets.
#
# PRODUCTION RULE: In production (NODE_ENV=production) the API REFUSES TO
# START if any of the following are missing: MONGODB_URI, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET, CORS_ORIGINS. There are no secret fallbacks.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
API_BASE_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# --- Database (REQUIRED in production) ---------------------------------------
# MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/obiren_development

# --- Auth / JWT (REQUIRED in production, min 32 chars, must differ) ----------
JWT_ACCESS_SECRET=change-me-min-32-chars-random-string-here!
JWT_REFRESH_SECRET=change-me-another-min-32-char-random-string!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS (REQUIRED in production) ------------------------------------------
# Comma-separated list of allowed origins. No defaults in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Internal jobs ----------------------------------------------------------
# Bearer/secret for /api/v1/internal/cron/* endpoints. If unset in production
# those endpoints are UNAUTHENTICATED - always set this in production.
CRON_SECRET=change-me-cron-secret-min-16-chars

# --- Cloudinary (Health Vault document storage) -----------------------------
# If unset in production, Health Vault upload/download endpoints return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=obiren-health-vault-private

# --- Twilio (WhatsApp/SMS notifications) ------------------------------------
# If unset in production, outbound notifications are simulated and flagged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/twilio/whatsapp/status
TWILIO_INBOUND_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/twilio/whatsapp/inbound

# --- Email (verification / password reset delivery) -------------------------
MAILTRAP_TOKEN=
MAILTRAP_FROM_EMAIL=no-reply@obiren.com
MAILTRAP_FROM_NAME=Obiren Platform

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug                 # debug in dev; info recommended in production
APP_VERSION=1.0.0
