# =============================================================================
# Obiren API environment configuration
# =============================================================================
# Copy this file to apps/api/.env and fill in real values. NEVER commit secrets.
#
# PRODUCTION RULE: with NODE_ENV=production the API refuses to start and lists
# every missing variable. Required in production:
#   MONGODB_URI, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, CORS_ORIGINS,
#   REDIS_URL, CRON_SECRET, HEALTH_DATA_ENCRYPTION_KEY, RESEND_API_KEY,
#   EMAIL_FROM
# Payment credentials are additionally required when PAYMENT_ENABLED=true.
# There are no secret fallbacks in production.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
WEB_APP_URL=http://localhost:3001
LOG_LEVEL=debug                 # debug in development; info in production

# --- Database (REQUIRED in production) --------------------------------------
# MongoDB Atlas or a local mongod. Migrations: npm run migrate
MONGODB_URI=mongodb://127.0.0.1:27017/obiren_development

# --- Auth / JWT (REQUIRED in production) ------------------------------------
# Min 32 characters each, and they must differ.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- CORS (REQUIRED in production) ------------------------------------------
# Comma-separated origin allow-list. No wildcard is used with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Redis (REQUIRED in production) -----------------------------------------
# Distributed rate limiting (and, from Tier 3, BullMQ job queues).
# Local option: docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379

# --- Rate limiting ----------------------------------------------------------
# Global limit applies to every route; auth limit is additive on credential,
# guardian-invite and SOS POSTs. Windows are milliseconds.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL_MS=900000
THROTTLE_AUTH_LIMIT=10

# --- Idempotency ------------------------------------------------------------
# Lifetime of stored Idempotency-Key responses (booking holds, payment
# intents, guardian invites, SOS).
IDEMPOTENCY_TTL_SECONDS=86400

# --- Health data encryption (REQUIRED in production) ------------------------
# Encrypts daily-log private notes, pregnancy notes and consultation messages
# (AES-256-GCM). Exactly 32 bytes: 64 hex characters or base64.
# Generate with: openssl rand -hex 32. Never reuse a JWT key.
HEALTH_DATA_ENCRYPTION_KEY=
HEALTH_DATA_ENCRYPTION_KEY_ID=default

# --- Internal jobs ----------------------------------------------------------
# Sent in the X-Cron-Secret header to /api/v1/internal/cron/*. Endpoints are
# denied when this is unset, in every environment.
CRON_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# REQUIRED in production so verification and password-reset emails deliver.
# Domain must be verified in the Resend dashboard. Without a key, development
# and tests use an in-process capture provider (nothing is transmitted).
RESEND_API_KEY=
EMAIL_FROM=no-reply@obiren.local
EMAIL_FROM_NAME=Obiren

# --- Payments (Paystack) ----------------------------------------------------
# Payments stay disabled unless explicitly enabled with an approved policy
# version. Never confirm a payment from a client callback.
PAYMENT_ENABLED=false
PAYMENT_POLICY_VERSION=
PAYSTACK_SECRET_KEY=

# --- Cloudinary (Health Vault document storage) -----------------------------
# If unset, Health Vault upload/download endpoints return 503 rather than
# pretending storage works. Scheduled for replacement by an S3-compatible
# provider behind the same interface (deferred).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Twilio (WhatsApp notifications and webhook signature checks) -----------
# If unset, outbound notifications are marked failed, never sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Waitlist (non-PRD, additive) -------------------------------------------
# Password for the restricted waitlist list view (x-waitlist-password header).
WAITLIST_LIST_PASSWORD=
