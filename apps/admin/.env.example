# Admin app configuration (Next.js). Copy to .env.local for local development.

# Where the Admin app proxies /api/v1/*. Use the deployed API in staging/production.
API_PROXY_TARGET=http://localhost:3000

# Public base URL of the Doctor Portal, used to build the one-time activation
# link shown when email delivery is not configured.
# Local: http://localhost:3003    Staging/Prod: https://doctor.<your-domain>
NEXT_PUBLIC_DOCTOR_PORTAL_URL=http://localhost:3003
